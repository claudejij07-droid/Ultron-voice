<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F8">

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- ULTRON BRAND -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ULTRON"
                android:textColor="#E3262E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:layout_marginBottom="30dp" />

            <!-- GREETING -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hello sir,\nHow can I help you?"
                android:textColor="#171717"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <!-- RED ACCENT -->
            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="20dp"
                android:background="#E3262E" />

            <!-- ULTRON CORE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/ultron_header">

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:src="@drawable/ultron_core"
                    android:contentDescription="Ultron Core"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ULTRON CORE"
                    android:textColor="#E3262E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:letterSpacing="0.25"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- GAP -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="26dp" />

            <!-- PROJECT CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New project in mind, sir?"
                        android:textColor="#171717"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ready when you are, sir."
                        android:textColor="#777777"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- INPUT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <EditText
            android:id="@+id/inputText"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Ask anything..."
            android:textSize="16sp"
            android:textColor="#171717"
            android:textColorHint="#999999"
            android:background="@drawable/input_background"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/voiceButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_ultron_mic"
            android:tint="#E3262E"
            android:contentDescription="Voice" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/circle_red"
            android:src="@drawable/ic_ultron_send"
            android:tint="#FFFFFF"
            android:contentDescription="Send"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>
